# Environment Configuration for Synthetic Review Generator
# Copy this file to .env and fill in your API keys

# OpenAI Configuration (optional - enable in config.yaml when available)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (optional - enable in config.yaml when available)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (default - should work out of the box)
OLLAMA_BASE_URL=http://localhost:11434

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Output Directory
OUTPUT_DIR=./data/generated

# Real Reviews Directory (for comparison)
REAL_REVIEWS_DIR=./data/real_reviews
